# Copy this file to .env and fill in your values. .env is ignored by git - never commit your token.

# Token from @BotFather (looks like 123456789:AAH...)
TELEGRAM_BOT_TOKEN=
# Your chat id (a number; for a group it starts with -)
TELEGRAM_CHAT_ID=

# Which detectors may send a message: any of rules, isolation_forest, random_forest
NOTIFY_METHODS=rules,isolation_forest,random_forest
# Send "resolved" after this many seconds without any alert
NOTIFY_RESOLVE_AFTER_S=60
